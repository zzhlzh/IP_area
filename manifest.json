{
  "action": {
    "default_popup": "popup.html",
    "default_title": "地区对齐检测"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "常驻检测 IP 出口地、设备时区和账号地区是否对得上，对不上时提前提醒：这个操作可能会触发安全警告或功能限制。",
  "host_permissions": [
    "https://ipapi.co/*",
    "https://ipwho.is/*",
    "https://api.country.is/*"
  ],
  "manifest_version": 3,
  "name": "地区对齐检测 · IP / 时区 / 账号",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "short_name": "地区对齐检测",
  "version": "1.1.0"
}